	    z-index: 1000;
	    max-height: 200px;
	    overflow-y: auto;
	    border-radius: 8px; /* 圆角 */
	    transition: all 0.3s ease-in-out; /* 动画过渡 */
	  font-family: 'Noto Sans CJK SC', '思源黑体', sans-serif; /* 使用正确的字体族属性 */
	}
	.dropdown-item {
	  padding: 12px 20px;
	    cursor: pointer;
	    text-align: center;
	    font-weight: 500;
	    transition: background-color 0.3s, transform 0.3s; /* 背景和缩放过渡 */
	}
	
	/* 鼠标悬停时的效果 */
	.dropdown-item:hover {
	  background-color: #f0f0f0;
	  transform: scale(1.05); /* 鼠标悬停时项略微放大 */
	}

	/* 在点击时给下拉项添加按下效果 */
	.dropdown-item:active {
	  background-color: #e0e0e0;
	  transform: scale(0.98); /* 按下时略微缩小 */
	}
