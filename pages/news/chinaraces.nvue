		  max-width: 50%;
		  display: flex;
		  justify-content: center;  /* 水平居中 */
		  align-items: center;      /* 垂直居中 */
		  box-sizing: border-box;
		  margin-left: 5px;
		  // background-color: #f0f0f0; /* 默认灰色背景 */
		}
		/* 设置圆角 */
		.rounded-corners {
		    border-radius: 5px; /* 圆角半径为2px */
		    /* 可以根据需要添加其他样式，比如背景颜色、文字对齐等 */
